<!DOCTYPE html>
<html lang="id" data-bs-theme="dark">
<head>
  <base target="_top">
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>3NET Customer Hub</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <style>
    :root{
      --bg:#040a1c; --neon:#19c3ff; --electric:#2f6bff;
      --ink:#e8f1ff; --muted:#8fa6c9;
      --ok:#2ee6a6; --warn:#ffc857; --bad:#ff5c7a;
      --glass:rgba(255,255,255,.055); --line:rgba(110,190,255,.2);
      --r:18px; --r-sm:12px;
    }
    *{box-sizing:border-box}
    body{
      font-family:'Plus Jakarta Sans',system-ui,-apple-system,'Segoe UI',sans-serif;
      color:var(--ink); background:var(--bg); min-height:100vh; margin:0;
    }
    .bg-orbs{
      position:fixed; inset:0; z-index:-1;
      background:
        radial-gradient(900px 500px at 8% -10%, rgba(25,195,255,.24), transparent 60%),
        radial-gradient(700px 520px at 100% 8%, rgba(47,107,255,.26), transparent 60%),
        radial-gradient(600px 420px at 50% 112%, rgba(25,195,255,.14), transparent 60%),
        var(--bg);
    }
    .glass{
      background:var(--glass);
      -webkit-backdrop-filter:blur(18px) saturate(140%);
      backdrop-filter:blur(18px) saturate(140%);
      border:1px solid var(--line);
      border-radius:var(--r);
      box-shadow:0 10px 40px rgba(0,0,0,.35), inset 0 1px 0 rgba(255,255,255,.06);
    }

    /* ---------- Layout CRM ---------- */
    .shell{
      display:grid; grid-template-columns:232px minmax(0,1fr); grid-template-rows:auto 1fr;
      gap:16px; padding:16px; min-height:100vh; max-width:1500px; margin:0 auto;
    }
    .topbar{
      grid-column:1/-1; position:sticky; top:12px; z-index:30;
      display:flex; align-items:center; gap:16px; padding:10px 18px;
    }
    .brand{display:flex; align-items:center; gap:12px; min-width:0}
    .brand img{
      height:46px; width:auto; max-width:140px; object-fit:contain;
      filter:drop-shadow(0 0 10px rgba(25,195,255,.65)) drop-shadow(0 0 22px rgba(47,107,255,.45));
    }
    .brand-fallback{
      display:none; font-weight:800; font-size:1.7rem; letter-spacing:.02em; color:var(--neon);
      text-shadow:0 0 14px rgba(25,195,255,.85), 0 0 34px rgba(47,107,255,.6);
    }
    .brand-text{line-height:1.15; min-width:0}
    .brand-text strong{display:block; font-size:1.02rem; font-weight:700}
    .brand-text span{font-size:.78rem; color:var(--muted)}
    .top-right{margin-left:auto; display:flex; align-items:center; gap:10px}
    .chip{
      display:inline-flex; align-items:center; gap:8px; padding:7px 13px; border-radius:999px;
      border:1px solid var(--line); background:rgba(25,195,255,.08); font-size:.84rem; font-weight:600; white-space:nowrap;
    }
    .chip i{color:var(--neon)}

    .sidebar{position:sticky; top:96px; align-self:start; padding:12px}
    .nav-item{
      display:flex; align-items:center; gap:12px; width:100%; padding:11px 14px; margin-bottom:6px;
      background:transparent; border:1px solid transparent; border-radius:var(--r-sm);
      color:var(--muted); font:inherit; font-weight:600; text-align:left; cursor:pointer;
      transition:background .2s,color .2s,border-color .2s,box-shadow .2s;
    }
    .nav-item i{font-size:1.1rem}
    .nav-item:hover{color:var(--ink); background:rgba(255,255,255,.05)}
    .nav-item:focus-visible{outline:2px solid var(--neon); outline-offset:2px}
    .nav-item.active{
      color:#fff; background:linear-gradient(135deg,rgba(25,195,255,.2),rgba(47,107,255,.2));
      border-color:rgba(25,195,255,.5); box-shadow:0 0 18px rgba(25,195,255,.2);
    }
    .nav-item.active i{color:var(--neon)}

    .content{min-width:0}
    .page-head{margin-bottom:16px}
    .page-head h1{font-size:1.5rem; font-weight:800; margin:0}
    .page-head p{margin:2px 0 0; color:var(--muted); font-size:.92rem}

    /* ---------- Statistik ---------- */
    .stat{padding:18px; height:100%; position:relative; overflow:hidden}
    .stat .ico{
      width:42px; height:42px; border-radius:12px; display:grid; place-items:center; font-size:1.2rem;
      color:var(--neon); background:rgba(25,195,255,.12); border:1px solid rgba(25,195,255,.35);
      box-shadow:0 0 16px rgba(25,195,255,.25);
    }
    .stat .val{font-size:2rem; font-weight:800; line-height:1.1; margin-top:12px}
    .stat .lbl{color:var(--muted); font-size:.86rem; margin-top:2px}
    .shimmer{color:transparent!important; border-radius:8px; background:linear-gradient(90deg,rgba(255,255,255,.06),rgba(255,255,255,.16),rgba(255,255,255,.06)); background-size:200% 100%; animation:shim 1.2s linear infinite}
    @keyframes shim{to{background-position:-200% 0}}

    .panel{padding:20px}
    .panel h2{font-size:1.05rem; font-weight:700; margin:0 0 14px}
    .bar-row{margin-bottom:14px}
    .bar-row .top{display:flex; justify-content:space-between; font-size:.88rem; margin-bottom:6px}
    .bar-row .top span:last-child{color:var(--muted)}
    .bar-track{height:9px; border-radius:99px; background:rgba(255,255,255,.07); overflow:hidden}
    .bar-fill{height:100%; border-radius:99px; background:linear-gradient(90deg,var(--electric),var(--neon)); box-shadow:0 0 12px rgba(25,195,255,.7); transition:width .7s cubic-bezier(.2,.8,.2,1)}

    /* ---------- Tabel ---------- */
    .table{
      --bs-table-bg:transparent; --bs-table-color:var(--ink);
      --bs-table-hover-bg:rgba(25,195,255,.07); --bs-table-hover-color:var(--ink);
      --bs-table-border-color:var(--line); margin:0; font-size:.9rem;
    }
    .table thead th{color:var(--muted); font-weight:600; font-size:.82rem; border-bottom-color:var(--line); white-space:nowrap}
    .table td{vertical-align:middle}
    .cid{font-weight:700; color:var(--neon); white-space:nowrap}
    .sub{display:block; color:var(--muted); font-size:.8rem}
    .badge-s{display:inline-block; padding:4px 11px; border-radius:99px; font-size:.78rem; font-weight:700; border:1px solid}
    .badge-s.aktif{color:var(--ok); border-color:rgba(46,230,166,.45); background:rgba(46,230,166,.1)}
    .badge-s.isolir{color:var(--warn); border-color:rgba(255,200,87,.45); background:rgba(255,200,87,.1)}
    .badge-s.nonaktif{color:var(--bad); border-color:rgba(255,92,122,.45); background:rgba(255,92,122,.1)}
    .empty{padding:36px 12px; text-align:center; color:var(--muted)}
    .empty i{font-size:2rem; color:var(--neon); display:block; margin-bottom:8px}

    /* ---------- Form ---------- */
    .form-card{position:relative; padding:24px; overflow:hidden}
    .form-label{font-weight:600; font-size:.88rem; margin-bottom:6px}
    .form-control,.form-select{
      background:rgba(4,12,34,.55); border:1px solid var(--line); color:var(--ink);
      border-radius:var(--r-sm); padding:.7rem .9rem;
    }
    .form-control::placeholder{color:rgba(143,166,201,.6)}
    .form-control:focus,.form-select:focus{
      background:rgba(4,12,34,.78); color:var(--ink); border-color:var(--neon);
      box-shadow:0 0 0 .2rem rgba(25,195,255,.16), 0 0 20px rgba(25,195,255,.28);
    }
    .form-select option{background:#0a1530; color:var(--ink)}
    .form-control[readonly]{background:rgba(25,195,255,.06); color:#cfe9ff}
    .id-field{font-weight:800; color:var(--neon)!important; letter-spacing:.03em; text-shadow:0 0 12px rgba(25,195,255,.7); border-color:rgba(25,195,255,.5)}
    .form-text{color:var(--muted)}

    .btn-neon{
      border:0; color:#021024; font-weight:800; padding:.8rem 1.6rem; border-radius:var(--r-sm);
      background:linear-gradient(135deg,var(--neon),var(--electric));
      box-shadow:0 0 22px rgba(25,195,255,.5), 0 8px 24px rgba(47,107,255,.35);
      transition:transform .15s, box-shadow .2s, filter .2s;
    }
    .btn-neon:hover{color:#021024; transform:translateY(-1px); box-shadow:0 0 30px rgba(25,195,255,.75), 0 10px 28px rgba(47,107,255,.45)}
    .btn-neon:disabled{filter:saturate(.6) brightness(.9); transform:none}
    .btn-ghost{background:rgba(255,255,255,.06); border:1px solid var(--line); color:var(--ink); border-radius:var(--r-sm); font-weight:600}
    .btn-ghost:hover{background:rgba(255,255,255,.12); color:#fff}

    .saving-overlay{
      position:absolute; inset:0; z-index:10; display:none; place-items:center; align-content:center; gap:14px;
      background:rgba(4,10,28,.72); -webkit-backdrop-filter:blur(6px); backdrop-filter:blur(6px); text-align:center;
    }
    .is-saving .saving-overlay{display:grid}
    .ring{
      width:64px; height:64px; border-radius:50%;
      border:4px solid rgba(25,195,255,.18); border-top-color:var(--neon);
      box-shadow:0 0 24px rgba(25,195,255,.55); animation:spin .9s linear infinite;
    }
    @keyframes spin{to{transform:rotate(360deg)}}

    /* ---------- Modal sukses ---------- */
    .modal-content{background:rgba(8,18,48,.88); -webkit-backdrop-filter:blur(20px); backdrop-filter:blur(20px); border:1px solid rgba(25,195,255,.4); border-radius:22px; box-shadow:0 0 50px rgba(25,195,255,.25)}
    .check{width:84px; height:84px; margin:0 auto 12px}
    .check circle{fill:none; stroke:var(--ok); stroke-width:3; stroke-dasharray:166; stroke-dashoffset:166; animation:draw .6s .1s ease forwards}
    .check path{fill:none; stroke:var(--ok); stroke-width:4; stroke-linecap:round; stroke-linejoin:round; stroke-dasharray:48; stroke-dashoffset:48; animation:draw .4s .6s ease forwards}
    @keyframes draw{to{stroke-dashoffset:0}}
    .new-id{font-size:2rem; font-weight:800; color:var(--neon); text-shadow:0 0 18px rgba(25,195,255,.8)}

    /* ---------- Pembayaran ---------- */
    .stat .val.money{font-size:clamp(1.15rem,4.4vw,1.7rem)}
    .picker{position:relative}
    .picker-results{
      position:absolute; left:0; right:0; top:calc(100% + 6px); z-index:25; display:none;
      max-height:280px; overflow:auto; padding:6px;
      background:rgba(6,14,38,.97); border:1px solid rgba(25,195,255,.45); border-radius:var(--r-sm);
      box-shadow:0 18px 40px rgba(0,0,0,.55), 0 0 22px rgba(25,195,255,.18);
    }
    .picker-results.open{display:block}
    .pick{
      display:flex; justify-content:space-between; align-items:center; gap:10px; width:100%;
      padding:10px 12px; border:0; border-radius:10px; background:transparent; color:var(--ink);
      font:inherit; text-align:left; cursor:pointer;
    }
    .pick:hover,.pick.on{background:rgba(25,195,255,.12)}
    .picked{
      display:none; align-items:center; gap:14px; padding:12px 14px; border-radius:var(--r-sm);
      border:1px solid rgba(25,195,255,.5); background:rgba(25,195,255,.07); box-shadow:0 0 18px rgba(25,195,255,.15);
    }
    .picked.show{display:flex}
    .picked .avatar{
      width:42px; height:42px; flex:none; border-radius:50%; display:grid; place-items:center;
      font-weight:800; color:#021024; background:linear-gradient(135deg,var(--neon),var(--electric));
    }
    .picked .info{min-width:0; flex:1}
    .picked .info strong{display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap}
    .method-grid{display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:8px}
    .method{
      display:flex; flex-direction:column; align-items:center; gap:4px; padding:12px 6px; height:100%;
      border-radius:var(--r-sm); border:1px solid var(--line); background:rgba(4,12,34,.55);
      color:var(--muted); font-weight:600; font-size:.86rem; text-align:center; cursor:pointer;
      transition:color .2s,border-color .2s,background .2s,box-shadow .2s;
    }
    .method i{font-size:1.25rem}
    .method:hover{color:var(--ink); border-color:rgba(25,195,255,.45)}
    .btn-check:checked + .method{
      color:#fff; border-color:var(--neon); box-shadow:0 0 18px rgba(25,195,255,.35);
      background:linear-gradient(135deg,rgba(25,195,255,.22),rgba(47,107,255,.22));
    }
    .btn-check:checked + .method i{color:var(--neon)}
    .btn-check:focus-visible + .method{outline:2px solid var(--neon); outline-offset:2px}
    .input-group-text{background:rgba(25,195,255,.08); border:1px solid var(--line); color:var(--neon); font-weight:700; border-radius:var(--r-sm) 0 0 var(--r-sm)}
    .input-group > .form-control{border-radius:0 var(--r-sm) var(--r-sm) 0}
    .hint{font-size:.84rem; margin-top:6px}
    .hint.bad{color:var(--bad)}
    .hint.good{color:var(--ok)}

    /* ---------- Bukti pembayaran ---------- */
    .dropzone{
      display:flex; align-items:center; gap:14px; padding:14px; margin:0; cursor:pointer;
      border:1.5px dashed rgba(25,195,255,.45); border-radius:var(--r-sm); background:rgba(25,195,255,.04);
      transition:border-color .2s,background .2s,box-shadow .2s;
    }
    .dropzone:hover,.dropzone.drag{border-color:var(--neon); background:rgba(25,195,255,.1); box-shadow:0 0 20px rgba(25,195,255,.2)}
    .dropzone:focus-visible{outline:2px solid var(--neon); outline-offset:2px}
    .dz-ico{
      width:44px; height:44px; flex:none; border-radius:12px; display:grid; place-items:center; font-size:1.3rem;
      color:var(--neon); background:rgba(25,195,255,.12); border:1px solid rgba(25,195,255,.35);
    }
    .bukti-prev{
      display:none; align-items:center; gap:14px; padding:10px; border-radius:var(--r-sm);
      border:1px solid rgba(25,195,255,.5); background:rgba(25,195,255,.07);
    }
    .bukti-prev.show{display:flex}
    .bukti-prev img{width:64px; height:64px; object-fit:cover; border-radius:10px; border:1px solid var(--line); flex:none}
    .bukti-prev .info{min-width:0; flex:1}
    .bukti-img{display:block; max-width:100%; max-height:70vh; margin:0 auto; border-radius:12px; border:1px solid var(--line)}

    /* ---------- Login ---------- */
    .login-card{max-width:420px; margin:8px auto 0; padding:28px 24px}
    .lock-ico{
      width:56px; height:56px; margin:0 auto 14px; border-radius:16px; display:grid; place-items:center; font-size:1.6rem;
      color:var(--neon); background:rgba(25,195,255,.12); border:1px solid rgba(25,195,255,.45); box-shadow:0 0 24px rgba(25,195,255,.35);
    }
    .login-card h2{font-size:1.2rem; font-weight:800; text-align:center; margin:0 0 4px}
    .login-card .lead-sub{text-align:center; color:var(--muted); font-size:.9rem; margin-bottom:20px}
    .pw-group > .form-control{border-radius:var(--r-sm) 0 0 var(--r-sm)}
    .pw-group > .btn{border-radius:0 var(--r-sm) var(--r-sm) 0; border-left:0}
    .stat .val.locked{display:flex; align-items:center; gap:8px; min-height:2.2rem; font-size:1.05rem; font-weight:600; color:var(--muted)}

    /* ---------- Keuangan ---------- */
    .method-grid.two{grid-template-columns:repeat(2,minmax(0,1fr))}
    .stat .lbl.sm{font-size:.78rem}
    .stat.saldo-hero{padding:20px 22px; border-color:rgba(25,195,255,.5); box-shadow:0 10px 40px rgba(0,0,0,.35), 0 0 34px rgba(25,195,255,.22), inset 0 1px 0 rgba(255,255,255,.06)}
    .stat.saldo-hero .val.money{margin-top:2px; font-size:clamp(1.6rem,6.5vw,2.3rem); text-shadow:0 0 18px rgba(25,195,255,.45)}
    .stat.saldo-hero .val.neg{text-shadow:none}
    .amt-in{color:var(--ok)}
    .amt-out{color:var(--bad)}
    .stat .val.neg{color:var(--bad)}
    input[type="date"].form-control{min-height:calc(1.5em + 1.4rem + 2px)}

    /* ---------- Tagihan ---------- */
    .seg{display:inline-flex; flex-wrap:wrap; gap:4px; padding:4px; border:1px solid var(--line); border-radius:var(--r-sm); background:rgba(4,12,34,.55)}
    .seg-btn{border:0; background:transparent; color:var(--muted); font:inherit; font-weight:600; font-size:.9rem; padding:8px 16px; border-radius:9px; cursor:pointer; transition:color .2s,background .2s,box-shadow .2s}
    .seg-btn:hover{color:var(--ink)}
    .seg-btn:focus-visible{outline:2px solid var(--neon); outline-offset:2px}
    .seg-btn.active{color:#fff; background:linear-gradient(135deg,rgba(25,195,255,.25),rgba(47,107,255,.25)); box-shadow:0 0 14px rgba(25,195,255,.25)}
    .badge-s.lunas{color:var(--ok); border-color:rgba(46,230,166,.45); background:rgba(46,230,166,.1)}
    .badge-s.belum{color:var(--bad); border-color:rgba(255,92,122,.45); background:rgba(255,92,122,.1)}
    .badge-s.notarif{color:var(--warn); border-color:rgba(255,200,87,.45); background:rgba(255,200,87,.1)}
    .act-group{display:inline-flex; flex-wrap:wrap; justify-content:flex-end; gap:4px}
    .notice{display:flex; align-items:center; gap:12px; padding:12px 14px; margin-bottom:16px; border-radius:var(--r-sm); border:1px solid rgba(255,200,87,.5); background:rgba(255,200,87,.08)}
    .notice > i{color:var(--warn); font-size:1.3rem; flex:none}

    .badge-s.gratis{color:var(--neon); border-color:rgba(25,195,255,.5); background:rgba(25,195,255,.1)}
    .badge-s.selesai{color:var(--muted); border-color:rgba(143,166,201,.4); background:rgba(143,166,201,.08)}
    .hint.warn{color:var(--warn)}
    .btn-ghost.armed{border-color:var(--bad); color:var(--bad)}
    .pick:disabled{opacity:.55; cursor:not-allowed}

    /* Invoice */
    .inv-paper{background:#fff; color:#0b1b3a; border-radius:14px; overflow:hidden; font-size:.92rem; line-height:1.45; -webkit-print-color-adjust:exact; print-color-adjust:exact}
    .inv-head{display:flex; justify-content:space-between; align-items:center; gap:16px; padding:20px 28px; background:linear-gradient(135deg,#06122e,#0a2a6b); color:#fff}
    .inv-head img{height:44px; width:auto; max-width:140px; object-fit:contain}
    .inv-brand{font-size:1.8rem; font-weight:800; color:#19c3ff}
    .inv-title{text-align:right}
    .inv-h{font-size:1.4rem; font-weight:800; letter-spacing:.08em}
    .inv-body{padding:24px 28px}
    .inv-grid{display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:20px}
    .inv-k{font-size:.76rem; color:#5b6b8c; font-weight:600; margin-bottom:2px}
    .inv-v{word-break:break-word}
    .inv-r{text-align:right}
    .inv-table{width:100%; border-collapse:collapse; margin:8px 0 16px}
    .inv-table th,.inv-table td{padding:10px 8px; border-bottom:1px solid #e3e9f5; text-align:left; vertical-align:top}
    .inv-table th{font-size:.78rem; color:#5b6b8c; font-weight:700}
    .inv-table .r{text-align:right; white-space:nowrap}
    .inv-table tfoot td{font-weight:800}
    .inv-table tfoot tr:last-child td{border-bottom:0}
    .inv-stamp{display:inline-block; padding:3px 14px; border:3px solid; border-radius:8px; font-weight:800; letter-spacing:.08em; transform:rotate(-5deg)}
    .inv-stamp.ok{color:#15803d; border-color:#15803d}
    .inv-stamp.bad{color:#b91c1c; border-color:#b91c1c}
    .inv-note{padding:12px 14px; border-radius:10px; background:#eef4ff; white-space:pre-line; margin-bottom:12px}
    .inv-foot{text-align:center; color:#5b6b8c; font-size:.85rem; margin-top:8px}
    #printRoot{display:none}
    @media print{
      body{background:#fff!important}
      body > *:not(#printRoot){display:none!important}
      #printRoot{display:block!important}
      #printRoot .inv-paper{border-radius:0}
    }
    @media (max-width: 575.98px){
      .inv-head,.inv-body{padding:16px}
      .inv-grid{grid-template-columns:1fr}
      .inv-r{text-align:left}
    }

    /* ---------- Bottom nav (mobile) ---------- */
    .bottom-nav{
      display:none; position:fixed; left:12px; right:12px; bottom:12px; z-index:40;
      padding:6px; gap:4px; justify-content:space-around;
    }
    .bottom-nav .nav-item{flex-direction:column; gap:3px; margin:0; padding:8px 6px; font-size:.74rem; text-align:center; justify-content:center}

    @media (max-width: 991.98px){
      .shell{grid-template-columns:minmax(0,1fr); padding:12px; padding-bottom:96px}
      .sidebar{display:none}
      .bottom-nav{display:flex}
      .topbar{top:8px; padding:8px 12px}
      .brand img{height:38px}
      .brand-text span{display:none}
      #chipDate{display:none}
      .form-card{padding:18px}
    }
    @media (max-width: 575.98px){
      .brand-text{display:none}
      .stat .val{font-size:1.65rem}
      .method{padding:10px 2px; font-size:.78rem}
    }
    @media (prefers-reduced-motion: reduce){
      *{animation-duration:.01ms!important; animation-iteration-count:1!important; transition-duration:.01ms!important}
    }
    @media (max-width: 575.98px){
      .bottom-nav{left:8px; right:8px; gap:2px}
