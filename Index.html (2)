          <button type="button" class="btn btn-ghost" id="${p}Toggle" aria-label="Tampilkan password"><i class="bi bi-eye"></i></button>
        </div>
      </div>
      <div class="hint bad d-none" id="${p}Err" role="alert"></div>
      <button type="submit" class="btn btn-neon w-100 mt-3" id="${p}Btn">Masuk</button>
    </form>`;
  }

  Object.keys(AUTH).forEach(scope => {
    const a = AUTH[scope];
    const q = part => $('#' + a.p + part);
    $(a.lock).innerHTML = loginCardHtml(a);
    const err = msg => { q('Err').textContent = msg || ''; q('Err').classList.toggle('d-none', !msg); };

    q('Toggle').addEventListener('click', () => {
      const pw = q('Pass'), show = pw.type === 'password';
      pw.type = show ? 'text' : 'password';
      q('Toggle').querySelector('i').className = 'bi ' + (show ? 'bi-eye-slash' : 'bi-eye');
      q('Toggle').setAttribute('aria-label', show ? 'Sembunyikan password' : 'Tampilkan password');
    });

    q('Form').addEventListener('submit', e => {
      e.preventDefault();
      const u = q('User').value.trim(), pw = q('Pass').value;
      if (!u || !pw) { err('Isi username dan password.'); return; }
      err('');
      q('Form').classList.add('is-saving');
      q('Btn').disabled = true;
      google.script.run
        .withSuccessHandler(res => {
          q('Form').classList.remove('is-saving');
          q('Btn').disabled = false;
          if (!res.success) {
            err(res.message === 'Menu tidak dikenal.' ? 'Code.gs di server belum versi terbaru. Deploy ulang sebagai New version.' : res.message);
            q('Pass').value = ''; q('Pass').focus(); return;
          }
          q('User').value = ''; q('Pass').value = '';
          saveToken(scope, res.token);
          applyAuth(scope, true);
          if (a.onLogin) a.onLogin();
          loadData();
        })
        .withFailureHandler(e2 => {
          q('Form').classList.remove('is-saving');
          q('Btn').disabled = false;
          err('Gagal masuk: ' + (e2 && e2.message ? e2.message : e2));
        })
        .login(u, pw, scope);
    });

    $(a.logout).addEventListener('click', () => {
      const t = state.tokens[scope];
      saveToken(scope, null);
      if (a.onLogout) a.onLogout();
      applyAuth(scope, false);
      if (t) google.script.run.logout(t);
      loadData();
    });
  });

  /* ---------- Laporan keuangan ---------- */
  const KATEGORI = {
    'Pemasukan': ['Pemasangan baru', 'Penjualan perangkat', 'Lainnya'],
    'Pengeluaran': ['Bandwidth / upstream', 'Gaji / honor', 'Listrik', 'Perangkat & kabel', 'Operasional', 'Lainnya']
  };

  function todayISO() {
    const d = new Date();
    return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
  }
  function setKeuDate() {
    const t = state.keu.today || todayISO();
    $('#kTgl').value = t;
    $('#kTgl').max = t;
  }
  function fmtTgl(iso) {            // yyyy-MM-dd -> DD/MM/YYYY (sama dengan format di spreadsheet)
    const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(iso);
    return m ? m[3] + '/' + m[2] + '/' + m[1] : iso;
  }
  function fillKategori() {
    const chosen = $('input[name="kjenis"]:checked');
    const list = chosen ? KATEGORI[chosen.value] : [];
    $('#kKategori').innerHTML = '<option value="" selected disabled>Pilih kategori</option>' + list.map(k => `<option>${esc(k)}</option>`).join('');
  }
  (function () {
    const now = new Date();
    const opts = [];
    for (let i = 0; i < 12; i++) {
      const d = new Date(now.getFullYear(), now.getMonth() - i, 1);
      const v = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0');
      opts.push(`<option value="${v}">${esc(periodeLabel(v))}</option>`);
    }
    $('#keuBulan').innerHTML = opts.join('');
    fillKategori();
    setKeuDate();
  })();

  $$('input[name="kjenis"]').forEach(r => r.addEventListener('change', fillKategori));
  $('#kKategori').addEventListener('change', () => $('#kKategori').classList.remove('is-invalid'));
  $('#kTgl').addEventListener('input', () => $('#kTgl').classList.remove('is-invalid'));
  $('#kKet').addEventListener('input', () => $('#kKet').classList.remove('is-invalid'));
  $('#keuBulan').addEventListener('change', loadKeu);

  function kJumlahVal() { return Number($('#kJumlah').value.replace(/\D/g, '')) || 0; }
  $('#kJumlah').addEventListener('input', function () {
    const d = this.value.replace(/\D/g, '').slice(0, 10);
    this.value = d ? Number(d).toLocaleString('id-ID') : '';
    this.classList.remove('is-invalid');
  });

  function loadKeu() {
    if (!state.auth.keuangan) return;
    google.script.run
      .withSuccessHandler(renderKeu)
      .withFailureHandler(e => toast('Gagal memuat laporan: ' + (e && e.message ? e.message : e)))
      .getKeuanganData(state.tokens.keuangan, $('#keuBulan').value);
  }

  function renderKeu(res) {
    if (res.code === 'AUTH') { handleAuthLost('keuangan', res.message); return; }
    if (res.bulan !== $('#keuBulan').value) return;   // jawaban usang dari pilihan bulan sebelumnya
    state.keu.today = res.today;
    state.keu.nextId = res.nextId;
    state.keu.rows = res.rows;
    const r = res.ringkasan;
    const when = res.bulan === res.today.slice(0, 7) ? 'bulan ini' : periodeLabel(res.bulan);

    $('#kMasukLbl').textContent = 'Pemasukan ' + when;
    $('#kKeluarLbl').textContent = 'Pengeluaran ' + when;
    $('#kSaldoLbl').textContent = 'Saldo ' + when;
    $('#keuTitle').textContent = 'Transaksi ' + when;

    const set = (id, text) => { const el = $('#' + id); el.classList.remove('shimmer'); el.textContent = text; };
    set('kMasuk', rp(r.masuk));
    set('kKeluar', rp(r.keluar));
    set('kSaldo', (r.saldo < 0 ? '-' : '') + rp(Math.abs(r.saldo)));
    $('#kSaldo').classList.toggle('neg', r.saldo < 0);
    $('#kMasukDetail').textContent = 'Iuran pelanggan ' + rp(r.iuran) + ', lainnya ' + rp(r.lain);
    const sa = res.semua;
    set('kSaldoAkhir', (sa.saldo < 0 ? '-' : '') + rp(Math.abs(sa.saldo)));
    $('#kSaldoAkhir').classList.toggle('neg', sa.saldo < 0);
    $('#kSaldoAkhirDetail').textContent = 'Total pemasukan ' + rp(sa.masuk) + ' (iuran ' + rp(sa.iuran) + ', lainnya ' + rp(sa.lain) + '), total pengeluaran ' + rp(sa.keluar);
    $('#keuTotMasuk').textContent = rp(r.masuk);
    $('#keuTotKeluar').textContent = rp(r.keluar);

    $('#keuNote').textContent = 'Iuran pelanggan diambil otomatis dari menu Input pembayaran berdasarkan tanggal bayar.'
      + (res.truncated ? ' Menampilkan ' + res.rows.length + ' dari ' + res.total + ' transaksi terbaru, total di atas mencakup semuanya.' : '');

    $('#kId').value = res.nextId;
    // Tanggal server (WIB) jadi acuan: jam perangkat yang lebih maju tidak boleh membuat tanggal default "masa depan"
    $('#kTgl').max = res.today;
    if (!$('#kTgl').value || $('#kTgl').value > res.today) $('#kTgl').value = res.today;

    const none = '<td class="text-end text-secondary">-</td>';
    $('#keuBody').innerHTML = res.rows.length
      ? res.rows.map(t => {
          const masuk = t.jenis === 'Pemasukan';
          const amt = `<td class="text-end fw-bold text-nowrap ${masuk ? 'amt-in' : 'amt-out'}">${masuk ? '+' : '-'}${esc(rp(t.jumlah))}</td>`;
          return `<tr>
            <td class="cid d-none d-md-table-cell">${esc(t.id)}</td>
            <td class="text-nowrap d-none d-md-table-cell">${esc(fmtTgl(t.tgl))}</td>
            <td><strong>${esc(t.ket)}</strong><span class="sub">${esc(t.kategori)}<span class="d-md-none">, ${esc(fmtTgl(t.tgl))}</span></span></td>
            ${masuk ? amt + none : none + amt}
            <td class="text-center">${t.bukti
              ? `<button type="button" class="btn btn-ghost btn-sm px-2" data-bukti="${esc(t.id)}" aria-label="Lihat bukti ${esc(t.id)}"><i class="bi bi-image"></i></button>`
              : '<span class="text-secondary">-</span>'}</td></tr>`;
        }).join('')
      : '<tr><td colspan="6"><div class="empty"><i class="bi bi-journal-text"></i>Belum ada transaksi di periode ini.</div></td></tr>';
  }

  function validateKeu() {
    let ok = true, first = null;
    const bad = el => { el.classList.add('is-invalid'); ok = false; if (!first) first = el; };
    if (!$('#kKategori').value) bad($('#kKategori'));
    const tg = $('#kTgl').value;
    if (!tg || tg > (state.keu.today || todayISO())) bad($('#kTgl'));
    const j = kJumlahVal();
    if (!(j > 0 && j <= 1000000000)) bad($('#kJumlah'));
    if ($('#kKet').value.trim().length < 3) bad($('#kKet'));
    if (first) first.focus();
    return ok;
  }

  function setKeuSaving(on) {
    $('#keuCard').classList.toggle('is-saving', on);
    $('#btnKeuSave').disabled = on;
    $('#keuSpin').classList.toggle('d-none', !on);
    $('#keuIcon').classList.toggle('d-none', on);
    $('#keuText').textContent = on ? 'Menyimpan…' : 'Simpan transaksi';
  }

  function resetKeuForm() {
    $('#keuForm').reset();
    buktiKeu.clear();
    fillKategori();
    $$('#keuForm .is-invalid').forEach(el => el.classList.remove('is-invalid'));
    $('#kTgl').value = '';
    setKeuDate();
    $('#kId').value = state.keu.nextId;
  }
  $('#btnKeuReset').addEventListener('click', () => setTimeout(resetKeuForm, 0));

  $('#keuForm').addEventListener('submit', function (e) {
    e.preventDefault();
    if (!validateKeu()) return;
    if (buktiKeu.busy) { toast('Foto bukti masih diproses, coba lagi sebentar.'); return; }
    const payload = {
      jenis: $('input[name="kjenis"]:checked').value,
      kategori: $('#kKategori').value,
      tanggal: $('#kTgl').value,
      jumlah: kJumlahVal(),
      keterangan: $('#kKet').value.trim(),
      bukti: buktiKeu.file
    };
    $('#keuOverlayText').textContent = buktiKeu.file ? 'Mengunggah bukti dan menyimpan…' : 'Menyimpan transaksi…';
    setKeuSaving(true);
    google.script.run
      .withSuccessHandler(res => {
        setKeuSaving(false);
        if (!res.success) {
          if (res.code === 'AUTH') { handleAuthLost('keuangan', res.message); return; }
          toast(res.message);
          return;
        }
        showSuccess({
          title: 'Transaksi tersimpan',
          sub: res.jenis + ', ' + res.kategori + ', ' + rp(res.jumlah),
          id: res.id, again: 'Catat transaksi lagi', toText: 'Ke dashboard', target: 'dashboard'
        });
        const m = payload.tanggal.slice(0, 7);
        if ($('#keuBulan option[value="' + m + '"]')) $('#keuBulan').value = m;
        resetKeuForm();
        loadKeu();
      })
      .withFailureHandler(err => {
        setKeuSaving(false);
        toast('Gagal menyimpan: ' + (err && err.message ? err.message : err));
      })
      .saveKeuangan(payload, state.tokens.keuangan);
  });

  /* ---------- Tagihan pelanggan ---------- */
  (function () {
    const y = new Date().getFullYear(), m = String(new Date().getMonth() + 1).padStart(2, '0');
    $('#tgBulan').innerHTML = BULAN.map((b, i) => `<option value="${String(i + 1).padStart(2, '0')}">${b}</option>`).join('');
    $('#tgTahun').innerHTML = [y - 1, y, y + 1].map(v => `<option>${v}</option>`).join('');
    $('#tgBulan').value = m; $('#tgTahun').value = String(y);
  })();
  function tgPeriode() { return $('#tgTahun').value + '-' + $('#tgBulan').value; }
  ['tgBulan', 'tgTahun'].forEach(id => $('#' + id).addEventListener('change', loadTagihan));
  $('#btnTgRefresh').addEventListener('click', loadTagihan);

  function loadTagihan() {
    if (!state.auth.bayar) return;
    const mine = ++state.tagihan.seq;
    google.script.run
      .withSuccessHandler(res => {
        if (mine !== state.tagihan.seq) return;            // jawaban usang
        if (res.code === 'AUTH') { handleAuthLost('bayar', res.message); return; }
        renderTagihan(res);
      })
      .withFailureHandler(e => toast('Gagal memuat tagihan: ' + (e && e.message ? e.message : e)))
      .getTagihan(state.tokens.bayar, tgPeriode());
  }

  function renderTagihan(res) {
    const T = state.tagihan, r = res.ringkasan;
    T.rows = res.rows; T.periode = res.periode; T.pakets = res.pakets;
    state.tarif = res.tarif || state.tarif;

    const set = (id, text) => { const el = $('#' + id); el.classList.remove('shimmer'); el.textContent = text; };
    set('tgTotal', rp(r.total)); set('tgTerbayar', rp(r.terbayar)); set('tgBelum', rp(r.belum));
    set('tgLunas', r.lunas + ' / ' + r.pelanggan);
    $('#tgBelumLbl').textContent = 'Belum dibayar (' + r.belumCount + ' pelanggan)';

    const paidTagihan = res.rows.filter(x => x.status === 'Lunas').reduce((t, x) => t + x.tagihan, 0);
    const pct = r.total > 0 ? Math.min(100, Math.round(paidTagihan / r.total * 100)) : 0;
    $('#tgPct').textContent = pct + '%';
    $('#tgBar').style.width = pct + '%';

    const notice = res.tarifKosong || r.tanpaTarif > 0;
    $('#tgNotice').classList.toggle('d-none', !notice);
    $('#tgNoticeTitle').textContent = res.tarifKosong ? 'Tarif paket belum diatur.' : r.tanpaTarif + ' pelanggan memakai paket yang belum punya tarif.';

    const f = k => k === 'belum' ? r.belumCount + r.tanpaTarif : k === 'lunas' ? r.lunas : k === 'gratis' ? (r.gratis || 0) : res.rows.length;
    $$('#tgFilter [data-f]').forEach(b => { b.textContent = ({ semua: 'Semua', belum: 'Belum bayar', lunas: 'Lunas', gratis: 'Bebas tagihan' })[b.dataset.f] + ' (' + f(b.dataset.f) + ')'; });
    renderTagihanRows();
  }

  function waPhone(hp) { const d = String(hp || '').replace(/\D/g, ''); return d.charAt(0) === '0' ? '62' + d.slice(1) : d; }
  function waText(r, periode) {
    const when = periodeLabel(periode);
    if (r.status === 'Lunas') {
      return 'Halo ' + r.nama + ', pembayaran tagihan WiFi 3NET periode ' + when + ' sebesar ' + rp(r.jumlahBayar) +
        ' sudah kami terima pada ' + r.tglBayar + '. Terima kasih.';
    }
    return 'Halo ' + r.nama + ', kami dari 3NET.\nPengingat tagihan WiFi periode ' + when + ':\nPaket: ' + r.paket + '\nTagihan: ' + rp(r.tagihan) +
      '\nMohon segera melakukan pembayaran. Abaikan pesan ini bila sudah membayar.' + (INFO_PEMBAYARAN ? '\n\nPembayaran ke:\n' + INFO_PEMBAYARAN : '') + '\n\nTerima kasih.';
  }
  function waHref(r, periode) {
    const ph = waPhone(r.hp);
    return ph.length >= 9 ? 'https://wa.me/' + ph + '?text=' + encodeURIComponent(waText(r, periode)) : '';
  }

  function statusBadge(r) {
    const cls = r.status === 'Lunas' ? 'lunas' : r.status === 'Belum bayar' ? 'belum' : r.status === 'Bebas tagihan' ? 'gratis' : 'notarif';
    return `<span class="badge-s ${cls}">${esc(r.status)}</span>` +
      (r.status === 'Lunas' ? `<span class="sub">Dibayar ${esc(r.tglBayar)}</span>` : '') +
      (r.status === 'Bebas tagihan' && r.alasan ? `<span class="sub">${esc(r.alasan)}</span>` : '');
  }

  function renderTagihanRows() {
    const T = state.tagihan, q = ($('#tgSearch').value || '').toLowerCase().trim();
    const list = T.rows.filter(r =>
      (T.filter === 'semua' || (T.filter === 'lunas' ? r.status === 'Lunas' : T.filter === 'gratis' ? r.status === 'Bebas tagihan' : (r.status === 'Belum bayar' || r.status === 'Tarif belum diatur'))) &&
      (!q || (r.id + ' ' + r.nama + ' ' + r.hp).toLowerCase().includes(q)));

    $('#tgBody').innerHTML = list.length ? list.map(r => {
      const unpaid = r.status === 'Belum bayar' || r.status === 'Tarif belum diatur', hasTagihan = r.tagihan > 0, wa = hasTagihan ? waHref(r, T.periode) : '';
      return `<tr>
        <td><strong>${esc(r.nama)}</strong><span class="sub"><span class="cid">${esc(r.id)}</span> &nbsp;${esc(r.hp)}</span>
          <span class="sub d-md-none">${esc(r.paket)}</span><span class="d-md-none">${statusBadge(r)}</span></td>
        <td class="d-none d-md-table-cell">${esc(r.paket)}</td>
        <td class="text-end fw-bold text-nowrap">${hasTagihan ? esc(rp(r.tagihan)) : '-'}</td>
        <td class="d-none d-md-table-cell">${statusBadge(r)}</td>
        <td class="text-end"><div class="act-group">
          ${unpaid ? `<button type="button" class="btn btn-ghost btn-sm px-2" data-act="bayar" data-id="${esc(r.id)}" title="Catat pembayaran" aria-label="Catat pembayaran ${esc(r.nama)}"><i class="bi bi-cash-coin"></i></button>` : ''}
          ${wa ? `<a class="btn btn-ghost btn-sm px-2" href="${esc(wa)}" target="_blank" rel="noopener" title="${unpaid ? 'Kirim pengingat' : 'Kirim bukti lunas'} lewat WhatsApp" aria-label="Kirim WhatsApp ke ${esc(r.nama)}"><i class="bi bi-whatsapp"></i></a>` : ''}
          ${hasTagihan ? `<button type="button" class="btn btn-ghost btn-sm px-2" data-act="inv" data-id="${esc(r.id)}" title="Lihat invoice" aria-label="Lihat invoice ${esc(r.nama)}"><i class="bi bi-file-earmark-text"></i></button>` : ''}
        </div></td></tr>`;
    }).join('')
    : `<tr><td colspan="5"><div class="empty"><i class="bi bi-receipt"></i>${T.rows.length ? 'Tidak ada pelanggan pada filter ini.' : 'Belum ada pelanggan yang ditagih di periode ini.'}</div></td></tr>`;
  }
  $('#tgSearch').addEventListener('input', renderTagihanRows);
  $('#tgFilter').addEventListener('click', e => {
    const b = e.target.closest('[data-f]'); if (!b) return;
    state.tagihan.filter = b.dataset.f;
    $$('#tgFilter [data-f]').forEach(x => x.classList.toggle('active', x === b));
    renderTagihanRows();
  });
  $('#tgBody').addEventListener('click', e => {
    const b = e.target.closest('[data-act]'); if (!b) return;
    if (b.dataset.act === 'bayar') startPayment(b.dataset.id); else openInvoice(b.dataset.id);
  });

  // Dari tabel tagihan langsung ke form pembayaran, terisi pelanggan, periode, dan jumlah
  function startPayment(id) {
    const r = state.tagihan.rows.find(x => x.id === id);
    if (!r) return;
    const c = state.customers.find(x => x.id === id) || { id: r.id, nama: r.nama, hp: r.hp, paket: r.paket, status: 'Aktif' };
    const parts = state.tagihan.periode.split('-');
    if (!Array.from($('#pTahun').options).some(o => o.value === parts[0])) $('#pTahun').insertAdjacentHTML('beforeend', `<option>${esc(parts[0])}</option>`);
    setPayTab('input');
    if (state.picked) clearPicked(false);
    $('#pTahun').value = parts[0];
    $('#pBulan').value = parts[1];
    $('#pJumlah').value = r.tagihan > 0 ? Number(r.tagihan).toLocaleString('id-ID') : '';
    pickCustomer(c);
    $('#payCard').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  /* Invoice */
  function openInvoice(id) {
    const T = state.tagihan, r = T.rows.find(x => x.id === id);
    if (!r) return;
    $('#printRoot').innerHTML = '';
    const lunas = r.status === 'Lunas', no = 'INV-' + T.periode.replace('-', '') + '-' + r.id.replace(/^3NET-/, '');
    const logoOk = $('#logo').style.display !== 'none' && $('#logo').getAttribute('src');
    $('#invPaper').innerHTML = `
      <div class="inv-head">
        ${logoOk ? `<img src="${esc($('#logo').src)}" alt="3NET">` : '<span class="inv-brand">3NET</span>'}
        <div class="inv-title"><div class="inv-h">INVOICE</div><div>${esc(no)}</div></div>
      </div>
      <div class="inv-body">
        <div class="inv-grid">
          <div><div class="inv-k">Ditagihkan kepada</div>
            <div class="inv-v"><strong>${esc(r.nama)}</strong><br>${esc(r.id)}<br>${esc(r.hp)}<br>${esc(r.alamat)}</div></div>
          <div class="inv-r"><div class="inv-k">Periode tagihan</div><div class="inv-v"><strong>${esc(periodeLabel(T.periode))}</strong></div>
            <div class="inv-k" style="margin-top:10px">Status</div><span class="inv-stamp ${lunas ? 'ok' : 'bad'}">${lunas ? 'LUNAS' : 'BELUM DIBAYAR'}</span></div>
        </div>
        <table class="inv-table">
          <thead><tr><th>Deskripsi</th><th class="r">Jumlah</th></tr></thead>
          <tbody><tr><td>Layanan internet WiFi paket ${esc(r.paket)}<br><small>Periode ${esc(periodeLabel(T.periode))}</small></td><td class="r">${esc(rp(r.tagihan))}</td></tr></tbody>
          <tfoot>
            <tr><td>Total tagihan</td><td class="r">${esc(rp(r.tagihan))}</td></tr>
            ${lunas ? `<tr><td>Dibayar ${esc(r.tglBayar)}${r.metode ? ' lewat ' + esc(r.metode) : ''}</td><td class="r">${esc(rp(r.jumlahBayar))}</td></tr>` : ''}
          </tfoot>
        </table>
        ${INFO_PEMBAYARAN && !lunas ? `<div class="inv-note"><strong>Cara pembayaran</strong>\n${esc(INFO_PEMBAYARAN)}</div>` : ''}
        <div class="inv-foot">Terima kasih telah berlangganan 3NET.</div>
      </div>`;
    const wa = waHref(r, T.periode), a = $('#invWa');
    a.classList.toggle('d-none', !wa);
    if (wa) a.href = wa;
    bootstrap.Modal.getOrCreateInstance($('#invModal')).show();
  }
  $('#invPrint').addEventListener('click', () => {
    $('#printRoot').innerHTML = $('#invPaper').outerHTML.replace(' id="invPaper"', '');   // salinan tanpa id agar tidak ganda
    window.print();
  });
  window.addEventListener('afterprint', () => { $('#printRoot').innerHTML = ''; });

  /* Tarif paket */
  function tarifPakets() {
    const set = new Set([...PAKET_LIST, ...state.customers.map(c => c.paket), ...Object.keys(state.tarif), ...state.tagihan.pakets].filter(Boolean));
    return Array.from(set).sort((a, b) => ((parseFloat(a) || 0) - (parseFloat(b) || 0)) || (a < b ? -1 : 1));
  }
  function openTarif() {
    $('#tarifErr').classList.add('d-none');
    $('#tarifRows').innerHTML = tarifPakets().map((p, i) => `
      <div><label class="form-label" for="trf${i}">${esc(p)}</label>
        <div class="input-group"><span class="input-group-text">Rp</span>
          <input class="form-control" id="trf${i}" data-paket="${esc(p)}" inputmode="numeric" placeholder="Belum diatur" autocomplete="off"
            value="${state.tarif[p] ? esc(Number(state.tarif[p]).toLocaleString('id-ID')) : ''}"></div></div>`).join('');
    bootstrap.Modal.getOrCreateInstance($('#tarifModal')).show();
  }
  $$('[data-tarif]').forEach(b => b.addEventListener('click', openTarif));
  $('#tarifRows').addEventListener('input', e => {
    const d = e.target.value.replace(/\D/g, '').slice(0, 8);
    e.target.value = d ? Number(d).toLocaleString('id-ID') : '';
  });
  $('#tarifForm').addEventListener('submit', e => {
    e.preventDefault();
    const map = {};
    $$('#tarifRows [data-paket]').forEach(i => { map[i.dataset.paket] = Number(i.value.replace(/\D/g, '')) || 0; });
    $('#tarifErr').classList.add('d-none');
    $('#btnTarifSave').disabled = true; $('#tarifSpin').classList.remove('d-none'); $('#tarifText').textContent = 'Menyimpan…';
    const done = () => { $('#btnTarifSave').disabled = false; $('#tarifSpin').classList.add('d-none'); $('#tarifText').textContent = 'Simpan tarif'; };
    google.script.run
      .withSuccessHandler(res => {
        done();
        if (!res.success) {
          if (res.code === 'AUTH') { bootstrap.Modal.getOrCreateInstance($('#tarifModal')).hide(); handleAuthLost('bayar', res.message); return; }
          $('#tarifErr').textContent = res.message; $('#tarifErr').classList.remove('d-none'); return;
        }
        state.tarif = res.tarif;
        bootstrap.Modal.getOrCreateInstance($('#tarifModal')).hide();
        loadTagihan();
      })
      .withFailureHandler(err => { done(); $('#tarifErr').textContent = 'Gagal menyimpan: ' + (err && err.message ? err.message : err); $('#tarifErr').classList.remove('d-none'); })
      .saveTarif(map, state.tokens.bayar);
  });

  /* ---------- Bebas tagihan ---------- */
  function isFreeIn(id, periode) {
    return state.gratis.some(g => g.id === id && g.mulai <= periode && (!g.sampai || periode <= g.sampai));
  }
  function loadPayTab() {
    if (!state.auth.bayar) return;
    if (state.payTab === 'tagihan') loadTagihan();
    else if (state.payTab === 'gratis') loadGratis();
  }
  function refreshBilling() {
    loadData();
    if (state.tagihan.periode) loadTagihan();
  }

  function loadGratis() {
    if (!state.auth.bayar) return;
    const mine = ++state.gr.seq;
    google.script.run
      .withSuccessHandler(res => {
        if (mine !== state.gr.seq) return;                // jawaban usang
        if (res.code === 'AUTH') { handleAuthLost('bayar', res.message); return; }
        renderGratis(res);
      })
      .withFailureHandler(e => toast('Gagal memuat daftar: ' + (e && e.message ? e.message : e)))
      .getGratis(state.tokens.bayar);
  }

  function renderGratis(res) {
    const r = res.ringkasan;
    state.gr.rows = res.rows;
    const set = (id, text) => { const el = $('#' + id); el.classList.remove('shimmer'); el.textContent = text; };
    set('grAktif', String(r.aktif));
    set('grNilai', rp(r.nilai));
    $('#grNilaiNote').textContent = r.tanpaTarif > 0 ? r.tanpaTarif + ' pelanggan belum bertarif, tidak dihitung' : '';
    set('grPersen', (r.pelangganAktif > 0 ? Math.min(100, Math.round(r.aktif / r.pelangganAktif * 100)) : 0) + '%');
    $$('#grFilter [data-f]').forEach(b => {
      b.textContent = (b.dataset.f === 'aktif' ? 'Berlaku (' + (r.aktif + r.belumMulai) + ')' : 'Semua (' + res.rows.length + ')');
    });
    renderGratisRows();
  }

  function renderGratisRows() {
    const G = state.gr, q = ($('#grSearch').value || '').toLowerCase().trim();
    const list = G.rows.filter(r =>
      (G.filter === 'semua' || r.state !== 'Berakhir') &&
      (!q || (r.id + ' ' + r.nama + ' ' + r.hp + ' ' + r.alasan).toLowerCase().includes(q)));
    $('#grBody').innerHTML = list.length ? list.map(r => {
      const cls = r.state === 'Aktif' ? 'gratis' : r.state === 'Belum mulai' ? 'notarif' : 'selesai';
      const masa = periodeLabel(r.mulai) + ' - ' + (r.sampai ? periodeLabel(r.sampai) : 'seterusnya');
      return `<tr>
        <td><strong>${esc(r.nama)}</strong><span class="sub"><span class="cid">${esc(r.id)}</span> &nbsp;${esc(r.hp)}</span><span class="sub d-md-none">${esc(r.alasan)}</span></td>
        <td class="d-none d-md-table-cell">${esc(r.paket || '-')}</td>
        <td class="d-none d-md-table-cell">${esc(r.alasan)}</td>
        <td><span class="badge-s ${cls}">${esc(r.state)}</span><span class="sub">${esc(masa)}</span></td>
        <td class="text-end">${r.state !== 'Berakhir' ? `<button type="button" class="btn btn-ghost btn-sm px-3" data-end="${esc(r.id)}" aria-label="Akhiri bebas tagihan ${esc(r.nama)}">Akhiri</button>` : ''}</td></tr>`;
    }).join('')
    : `<tr><td colspan="5"><div class="empty"><i class="bi bi-gift"></i>${G.rows.length ? 'Tidak ada hasil pada filter ini.' : 'Belum ada pelanggan bebas tagihan.'}</div></td></tr>`;
  }
  $('#grSearch').addEventListener('input', renderGratisRows);
  $('#grFilter').addEventListener('click', e => {
    const b = e.target.closest('[data-f]'); if (!b) return;
    state.gr.filter = b.dataset.f;
    $$('#grFilter [data-f]').forEach(x => x.classList.toggle('active', x === b));
    renderGratisRows();
  });

  // Akhiri: klik pertama minta konfirmasi di tombol itu sendiri, klik kedua (dalam 4 detik) menjalankan
  $('#grBody').addEventListener('click', e => {
    const b = e.target.closest('[data-end]'); if (!b) return;
    if (b.dataset.armed !== '1') {
      b.dataset.armed = '1'; b.classList.add('armed'); b.textContent = 'Yakin?';
      b.setAttribute('aria-label', 'Yakin akhiri bebas tagihan? Klik sekali lagi untuk konfirmasi');
      setTimeout(() => { if (b.isConnected && !b.disabled) { b.dataset.armed = ''; b.classList.remove('armed'); b.textContent = 'Akhiri'; } }, 4000);
      return;
    }
    b.disabled = true;
    google.script.run
      .withSuccessHandler(res => {
        if (!res.success) {
          if (res.code === 'AUTH') { handleAuthLost('bayar', res.message); return; }
          b.disabled = false; toast(res.message); return;
        }
        loadGratis(); refreshBilling();
      })
      .withFailureHandler(err => { b.disabled = false; toast('Gagal: ' + (err && err.message ? err.message : err)); })
      .akhiriGratis(b.dataset.end, state.tokens.bayar);
  });

  /* Dialog tambah */
  (function () {
    const y = new Date().getFullYear();
    const bulan = BULAN.map((b, i) => `<option value="${String(i + 1).padStart(2, '0')}">${b}</option>`).join('');
    const tahun = [y - 1, y, y + 1, y + 2, y + 3].map(v => `<option>${v}</option>`).join('');
    ['grMulai', 'grSampai'].forEach(k => { $('#' + k + 'Bulan').innerHTML = bulan; $('#' + k + 'Tahun').innerHTML = tahun; });
  })();
  function grPeriode(k) { return $('#' + k + 'Tahun').value + '-' + $('#' + k + 'Bulan').value; }
  function setGrDefaults() {
    const n = new Date(), b = String(n.getMonth() + 1).padStart(2, '0'), t = String(n.getFullYear());
    ['grMulai', 'grSampai'].forEach(k => { $('#' + k + 'Bulan').value = b; $('#' + k + 'Tahun').value = t; });
  }
  function grErr(msg) { $('#grErr').textContent = msg || ''; $('#grErr').classList.toggle('d-none', !msg); }
  function closeGrResults() { $('#grResults').classList.remove('open'); }

  $('#btnGrAdd').addEventListener('click', () => {
    state.gr.picked = null;
    $('#gratisForm').reset();
    $('#grPicked').classList.remove('show'); $('#grPicker').classList.remove('d-none');
    $('#grSampaiWrap').classList.add('d-none');
    setGrDefaults(); grErr(''); closeGrResults();
    bootstrap.Modal.getOrCreateInstance($('#gratisModal')).show();
    setTimeout(() => $('#grCari').focus(), 300);
  });

  function grShow(q) {
    q = (q || '').toLowerCase().trim();
    const taken = new Set(state.gr.rows.filter(r => r.state !== 'Berakhir').map(r => r.id));
    const list = (q ? state.customers.filter(c => (c.id + ' ' + c.nama + ' ' + c.hp).toLowerCase().includes(q)) : state.customers).slice(0, 8);
    state.gr.items = list;
    $('#grResults').innerHTML = list.length
      ? list.map((c, i) => `<button type="button" class="pick" data-i="${i}" ${taken.has(c.id) ? 'disabled' : ''}>
          <span><strong>${esc(c.nama)}</strong><span class="sub"><span class="cid">${esc(c.id)}</span> &nbsp;${esc(c.hp)}</span></span>
          ${taken.has(c.id) ? '<span class="badge-s gratis">Sudah bebas</span>' : badge(c.status)}</button>`).join('')
      : '<div class="empty py-3">Pelanggan tidak ditemukan.</div>';
    $('#grResults').classList.add('open');
  }
  $('#grCari').addEventListener('input', e => grShow(e.target.value));
  $('#grCari').addEventListener('focus', e => grShow(e.target.value));
  $('#grResults').addEventListener('click', e => {
    const b = e.target.closest('.pick');
    if (!b || b.disabled) return;
    const c = state.gr.items[+b.dataset.i]; if (!c) return;
    state.gr.picked = c;
    $('#grAvatar').textContent = (c.nama.trim().charAt(0) || '?').toUpperCase();
    $('#grPkNama').textContent = c.nama;
    $('#grPkSub').innerHTML = `<span class="cid">${esc(c.id)}</span> &nbsp;${esc(c.hp)} &nbsp;${esc(c.paket)}`;
    $('#grPicked').classList.add('show'); $('#grPicker').classList.add('d-none');
    closeGrResults(); grErr('');
  });
  $('#grChange').addEventListener('click', () => {
    state.gr.picked = null;
    $('#grPicked').classList.remove('show'); $('#grPicker').classList.remove('d-none');
    $('#grCari').value = ''; $('#grCari').focus();
  });
  document.addEventListener('click', e => { if (!$('#grPicker').contains(e.target)) closeGrResults(); });
  $('#grBatas').addEventListener('change', () => {
    const on = $('#grBatas').checked;
    $('#grSampaiWrap').classList.toggle('d-none', !on);
    if (on) { $('#grSampaiBulan').value = $('#grMulaiBulan').value; $('#grSampaiTahun').value = $('#grMulaiTahun').value; }
  });

  $('#gratisForm').addEventListener('submit', e => {
    e.preventDefault();
    const G = state.gr;
    if (!G.picked) { grErr('Pilih pelanggan terlebih dahulu.'); return; }
    const alasan = $('#grAlasan').value.trim();
    if (alasan.length < 3) { grErr('Alasan minimal 3 karakter.'); return; }
    const mulai = grPeriode('grMulai'), sampai = $('#grBatas').checked ? grPeriode('grSampai') : '';
    if (sampai && sampai < mulai) { grErr('Periode akhir tidak boleh sebelum periode mulai.'); return; }
    grErr('');
    $('#btnGrSave').disabled = true; $('#grSpin').classList.remove('d-none'); $('#grText').textContent = 'Menyimpan…';
    const done = () => { $('#btnGrSave').disabled = false; $('#grSpin').classList.add('d-none'); $('#grText').textContent = 'Simpan'; };
    google.script.run
      .withSuccessHandler(res => {
        done();
        if (!res.success) {
          if (res.code === 'AUTH') { bootstrap.Modal.getOrCreateInstance($('#gratisModal')).hide(); handleAuthLost('bayar', res.message); return; }
          grErr(res.message); return;
        }
        bootstrap.Modal.getOrCreateInstance($('#gratisModal')).hide();
        loadGratis(); refreshBilling();
      })
      .withFailureHandler(err => { done(); grErr('Gagal menyimpan: ' + (err && err.message ? err.message : err)); })
      .saveGratis({ idp: G.picked.id, mulai: mulai, sampai: sampai, alasan: alasan }, state.tokens.bayar);
  });

  /* ---------- Init ---------- */
  Object.keys(AUTH).forEach(sc => { try { state.tokens[sc] = sessionStorage.getItem(AUTH[sc].key); } catch (e) { /* abaikan */ } });
  setToday();
  loadData();
</script>
</body>
</html>
