<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
  // Ubah daftar paket & status di sini sesuai layanan 3NET
  const PAKET_LIST = ['10 Mbps', '20 Mbps', '30 Mbps', '50 Mbps', '100 Mbps'];
  const STATUS_LIST = ['Aktif', 'Isolir', 'Nonaktif'];
  // Opsional: harga per paket agar jumlah bayar terisi otomatis, contoh: {'10 Mbps': 150000, '20 Mbps': 200000}
  const HARGA_PAKET = {};
  // Info pembayaran: tampil di invoice (yang belum lunas) dan di pesan pengingat WhatsApp.
  // Satu baris per elemen. Kosongkan daftar ([]) untuk menyembunyikannya.
  const INFO_PEMBAYARAN = [
    'Bank BCA 3431598408',
    'Bank Mandiri 1560014695060',
    'A.N. Deni Rohendi',
    'Dana 08211598803',
    'A.N. yp964943'
  ].join('\n');
  const BULAN = ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];

  const $ = (s, r = document) => r.querySelector(s);
  const $$ = (s, r = document) => Array.from(r.querySelectorAll(s));
  const state = { rows: [], nextId: '3NET-0001', customers: [], payments: [], paid: new Set(), nextPayId: 'PAY-0001', picked: null, okTarget: 'data', view: 'dashboard', payTab: 'input', tarif: {}, tagihan: { rows: [], periode: '', filter: 'semua', seq: 0, pakets: [] }, gratis: [], gr: { rows: [], filter: 'aktif', seq: 0, picked: null, items: [] }, tokens: { bayar: null, keuangan: null }, auth: { bayar: false, keuangan: false }, keu: { today: '', nextId: 'KEU-0001' } };

  const esc = s => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

  /* ---------- Logo: fallback bila Drive menolak hotlink ---------- */
  (function () {
    const img = $('#logo'); let tried = 0;
    img.addEventListener('error', function () {
      if (tried++ === 0) img.src = 'https://drive.google.com/thumbnail?id=1P_fqd-N45AIP7djESNM7tvRIOuy2tq8b&sz=w400';
      else { img.style.display = 'none'; $('#logoFallback').style.display = 'block'; }
    });
  })();

  /* ---------- Tanggal otomatis ---------- */
  function todayLong() {
    return new Date().toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
  }
  function setToday() { $('#tgl').value = todayLong(); $('#payTgl').value = todayLong(); $('#todayLong').textContent = todayLong(); }

  /* ---------- Navigasi ---------- */
  function updateNavActive() {
    $$('.nav-item').forEach(b => b.classList.toggle('active', b.dataset.view === state.view && (!b.dataset.tab || b.dataset.tab === state.payTab)));
  }
  function applyPayTab() {
    $('#payTabInput').classList.toggle('d-none', state.payTab !== 'input');
    $('#payTabTagihan').classList.toggle('d-none', state.payTab !== 'tagihan');
    $('#payTabGratis').classList.toggle('d-none', state.payTab !== 'gratis');
    $$('[data-ptab]').forEach(b => { const on = b.dataset.ptab === state.payTab; b.classList.toggle('active', on); b.setAttribute('aria-selected', String(on)); });
    updateNavActive();
  }
  function setPayTab(tab) {
    state.payTab = tab;
    applyPayTab();
    loadPayTab();
  }
  function showView(name, tab) {
    if (name === 'bayar' && tab) state.payTab = tab;
    state.view = name;
    ['dashboard', 'input', 'data', 'bayar', 'keuangan'].forEach(v => $('#view-' + v).classList.toggle('d-none', v !== name));
    applyPayTab();
    window.scrollTo({ top: 0, behavior: 'smooth' });
    if (AUTH[name] && !state.auth[name]) setTimeout(() => {
      const ae = document.activeElement;
      if (ae && ae.closest && ae.closest('.login-card')) return;   // pengguna sudah mengetik, jangan rebut fokus
      const u = $('#' + AUTH[name].p + 'User'); if (u) u.focus();
    }, 60);
    if (name === 'keuangan' && state.auth.keuangan) loadKeu();
    if (name === 'bayar') loadPayTab();
  }
  $$('.nav-item').forEach(b => b.addEventListener('click', () => showView(b.dataset.view, b.dataset.tab)));
  $$('[data-ptab]').forEach(b => b.addEventListener('click', () => setPayTab(b.dataset.ptab)));
  $$('[data-go]').forEach(b => b.addEventListener('click', () => showView(b.dataset.go)));

  /* ---------- Isi pilihan form ---------- */
  PAKET_LIST.forEach(p => $('#paket').insertAdjacentHTML('beforeend', `<option>${esc(p)}</option>`));
  STATUS_LIST.forEach(s => $('#status').insertAdjacentHTML('beforeend', `<option>${esc(s)}</option>`));

  /* ---------- Validasi nomor HP ---------- */
  function normPhone(raw) {
    let p = String(raw || '').replace(/[\s\-\.\(\)]/g, '');
    if (p.indexOf('+62') === 0) p = '0' + p.slice(3);
    else if (p.indexOf('62') === 0) p = '0' + p.slice(2);
    return /^08\d{8,11}$/.test(p) ? p : null;
  }
  $('#hp').addEventListener('input', function () {
    const v = this.value.trim();
    this.classList.remove('is-valid', 'is-invalid');
    if (!v) return;
    const n = normPhone(v);
    this.classList.add(n ? 'is-valid' : 'is-invalid');
    $('#hpOk').textContent = n ? 'Nomor valid: ' + n : '';
  });

  function validate() {
    let ok = true;
    const set = (el, good) => { el.classList.toggle('is-invalid', !good); el.classList.toggle('is-valid', good && el.id === 'hp'); if (!good) ok = false; };
    set($('#nama'), $('#nama').value.trim().length >= 3);
    set($('#hp'), !!normPhone($('#hp').value));
    set($('#alamat'), $('#alamat').value.trim().length >= 5);
    set($('#paket'), !!$('#paket').value);
    if (!ok) { const f = $('.is-invalid'); if (f) f.focus(); }
    return ok;
  }
  ['nama', 'alamat', 'paket'].forEach(id => $('#' + id).addEventListener('input', () => $('#' + id).classList.remove('is-invalid')));

  /* ---------- Render ---------- */
  function badge(s) { return `<span class="badge-s ${esc(String(s).toLowerCase())}">${esc(s)}</span>`; }

  function rowHtml(r, full) {
    return `<tr>
      <td class="cid">${esc(r.id)}</td>
      <td><strong>${esc(r.nama)}</strong><span class="sub">${esc(r.hp)}</span></td>
      ${full ? `<td class="d-none d-lg-table-cell">${esc(r.alamat)}</td>` : ''}
      <td class="d-none d-md-table-cell">${esc(r.paket)}</td>
      ${full ? `<td class="d-none d-md-table-cell">${esc(r.tgl)}</td>` : ''}
      <td>${badge(r.status)}</td></tr>`;
  }

  function emptyRow(cols) {
    return `<tr><td colspan="${cols}"><div class="empty"><i class="bi bi-inbox"></i>Belum ada pelanggan.<br>
      <button class="btn btn-neon btn-sm mt-3" onclick="showView('input')">Tambah pelanggan pertama</button></div></td></tr>`;
  }

  function renderData(rows, q) {
    q = (q || '').toLowerCase().trim();
    const list = q ? rows.filter(r => (r.id + ' ' + r.nama + ' ' + r.hp).toLowerCase().includes(q)) : rows;
    $('#dataBody').innerHTML = list.length
      ? list.map(r => rowHtml(r, true)).join('')
      : (q ? `<tr><td colspan="6"><div class="empty">Tidak ada hasil untuk "${esc(q)}".</div></td></tr>` : emptyRow(6));
  }

  function render(d) {
    state.rows = d.rows; state.nextId = d.nextId;
    [['stTotal', d.stats.total], ['stAktif', d.stats.aktif], ['stBulan', d.stats.bulanIni], ['stHari', d.stats.hariIni]]
      .forEach(([id, v]) => { const el = $('#' + id); el.classList.remove('shimmer'); el.textContent = v; });
    [['stMasuk', rp(d.stats.pemasukanBulan)], ['stBelum', d.stats.belumBayar]].forEach(([id, v]) => {
      const el = $('#' + id);
      el.classList.remove('shimmer');
      el.classList.toggle('locked', !d.authed);
      if (d.authed) el.textContent = v; else el.innerHTML = '<i class="bi bi-lock-fill"></i>Terkunci';
    });

    $('#idprev').value = d.nextId;

    const entries = Object.entries(d.paket).sort((a, b) => b[1] - a[1]);
    const max = entries.length ? entries[0][1] : 1;
