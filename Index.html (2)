  const MAX_FILE_MB = 15;
  function fmtSize(bytes) {
    return bytes >= 1048576 ? (bytes / 1048576).toFixed(1) + ' MB' : Math.max(1, Math.round(bytes / 1024)) + ' KB';
  }

  // Kecilkan foto agar unggahan cepat (maks. 1400 px, JPEG)
  function compressImage(file, maxDim, quality) {
    return new Promise((resolve, reject) => {
      const url = URL.createObjectURL(file);
      const img = new Image();
      img.onload = function () {
        try {
          const scale = Math.min(1, maxDim / Math.max(img.naturalWidth, img.naturalHeight));
          const w = Math.max(1, Math.round(img.naturalWidth * scale));
          const h = Math.max(1, Math.round(img.naturalHeight * scale));
          const c = document.createElement('canvas');
          c.width = w; c.height = h;
          const ctx = c.getContext('2d');
          ctx.fillStyle = '#fff'; ctx.fillRect(0, 0, w, h);
          ctx.drawImage(img, 0, 0, w, h);
          const dataUrl = c.toDataURL('image/jpeg', quality);
          URL.revokeObjectURL(url);
          resolve({ dataUrl: dataUrl, data: dataUrl.split(',')[1] });
        } catch (e) { URL.revokeObjectURL(url); reject(e); }
      };
      img.onerror = function () { URL.revokeObjectURL(url); reject(new Error('load')); };
      img.src = url;
    });
  }

  // ids: selektor untuk input, zone, prev, thumb, name, size, remove, err
  function makeUploader(ids) {
    const u = { file: null, busy: false };
    const el = k => $(ids[k]);
    const err = msg => { el('err').textContent = msg || ''; el('err').classList.toggle('d-none', !msg); };

    async function handle(file) {
      err('');
      if (!file) return;
      if (!/^image\//.test(file.type)) { err('File harus berupa gambar (JPG, PNG, atau WebP).'); return; }
      if (file.size > MAX_FILE_MB * 1048576) { err('Ukuran foto maksimal ' + MAX_FILE_MB + ' MB.'); return; }
      u.busy = true;
      try {
        const r = await compressImage(file, 1400, 0.82);
        u.file = { name: file.name.replace(/\.[^.]+$/, '') + '.jpg', mime: 'image/jpeg', data: r.data };
        el('thumb').src = r.dataUrl;
        el('name').textContent = file.name;
        el('size').textContent = fmtSize(file.size) + ' dikecilkan menjadi ' + fmtSize(Math.round(r.data.length * 0.75));
        el('prev').classList.add('show');
        el('zone').classList.add('d-none');
      } catch (e) {
        err('Foto tidak bisa dibaca. Coba format JPG, PNG, atau WebP.');
      } finally {
        u.busy = false;
      }
    }

    u.clear = function () {
      u.file = null;
      el('input').value = '';
      el('thumb').removeAttribute('src');
      el('prev').classList.remove('show');
      el('zone').classList.remove('d-none', 'drag');
      err('');
    };

    el('input').addEventListener('change', e => handle(e.target.files[0]));
    el('remove').addEventListener('click', u.clear);
    el('zone').addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); el('input').click(); } });
    ['dragenter', 'dragover'].forEach(ev => el('zone').addEventListener(ev, e => { e.preventDefault(); el('zone').classList.add('drag'); }));
    ['dragleave', 'drop'].forEach(ev => el('zone').addEventListener(ev, e => { e.preventDefault(); el('zone').classList.remove('drag'); }));
    el('zone').addEventListener('drop', e => handle(e.dataTransfer.files[0]));
    return u;
  }

